          "error_count",
          "oracle_answer",
          "record_id",
          "reward",
          "split",
          "task",
          "task_id",
          "trajectory_id",
          "trajectory_steps",
          "verifier_verdict"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "error_count": {
            "type": "integer"
          },
          "oracle_answer": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "reward": {
            "type": "number"
          },
          "split": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "trajectory_id": {
